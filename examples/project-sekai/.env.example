# 从 backend/ 目录通过 uv run --env-file 加载；只供独立的本机文字测试。
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
EIDOLON_CHARACTERS_PATH=../examples/project-sekai/characters.toml
EIDOLON_DATABASE_PATH=../examples/project-sekai/.local/eidolon.db
EIDOLON_DEV_LOGIN=1
HOST=127.0.0.1
EIDOLON_AFFINITY_AND_GIFTS=0
# 不配置语音、识别、向量化、判断、生图、素材桶和自动同步服务。
